# Macro definitions removed - they were dead, and noisy.
#
# The template's own note above says it: macros only work in a TOP-LEVEL
# .gitattributes. This file is at unity-project/BladeLoop/, so git rejected all
# three on every single command:
#
#   [attr]lfs ... not allowed: unity-project/BladeLoop/.gitattributes:10
#
# Sixteen lines of that per git command, drowning real output. They were never
# in effect, so removing them changes nothing about how any file is handled.
#
# DO NOT "fix" this by moving them to the repo-root .gitattributes. That would
# switch them ON, and they are not safe to switch on now:
#
#   * unity-yaml carries eol=lf, which would rewrite ~500 files in one commit
#     (390 .mat, 79 .asset, 15 .unity, plus .anim/.controller/.playable).
#   * the lfs macro is applied to ~40 binary extensions from line 74 down.
#     Turning it on would migrate already-committed binaries into LFS, and
#     git-lfs is not installed on every machine on this team.
#
# LFS is handled by the repo-root .gitattributes, which tracks *.blend and
# *.fbx explicitly and does work. Leave that alone.
#
# The unity-json / unity-yaml attribute names below are now undefined, exactly
# as they effectively were before. Anyone wanting real Unity YAML merging
# should raise it as its own change, after submission.

# Optionally collapse Unity YAML files on GitHub diffs
# [attr]unity-yaml        merge=unityyamlmerge text linguist-language=yaml linguist-generated

# Unity source files
*.cginc                 text
*.compute               text linguist-language=hlsl
*.cs                    text diff=csharp
*.hlsl                  text linguist-language=hlsl
*.raytrace              text linguist-language=hlsl
*.shader                text

# Unity JSON files
*.asmdef                unity-json
*.asmref                unity-json
*.index                 unity-json
*.inputactions          unity-json
*.shadergraph           unity-json
*.shadersubgraph        unity-json

# Unity UI Toolkit files
*.tss                   text diff=css linguist-language=css
*.uss                   text diff=css linguist-language=css
*.uxml                  text linguist-language=xml linguist-detectable

# Unity YAML files
*.anim                  unity-yaml
*.asset                 unity-yaml
*.brush                 unity-yaml
*.controller            unity-yaml
*.flare                 unity-yaml
*.fontsettings          unity-yaml
*.giparams              unity-yaml
*.guiskin               unity-yaml
*.lighting              unity-yaml
*.mask                  unity-yaml
*.mat                   unity-yaml
*.meta                  unity-yaml
*.mixer                 unity-yaml
*.overrideController    unity-yaml
*.playable              unity-yaml
*.prefab                unity-yaml
*.preset                unity-yaml
*.renderTexture         unity-yaml
*.scenetemplate         unity-yaml
*.shadervariants        unity-yaml
*.signal                unity-yaml
*.spriteatlas           unity-yaml
*.spriteatlasv2         unity-yaml
*.terrainlayer          unity-yaml
*.unity                 unity-yaml

# "physic" for 3D but "physics" for 2D
*.physicMaterial        unity-yaml
*.physicsMaterial2D     unity-yaml

# Exclude from GitHub stats and diffs: third-party plugins, packages lock file
Assets/Plugins/**           linguist-generated
Packages/packages-lock.json linguist-generated

