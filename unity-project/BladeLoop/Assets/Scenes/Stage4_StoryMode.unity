  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 3786388fb275d4709b159cd5bfbd1a8a, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::ClickablePart
  partTitle: STATIONARY DISCHARGE HOOD
  partDescription: "Receives the kiln discharge at 600 \xB0C as a chaotic cloud of
    gas and mixed solids. The top half expands into a vapor plenum \u2014 low-density
    syngas is vacuum-drawn upward while dense solids fall to the funnel below. Sealed
    by a double-row carbon block seal with pre-heated N\u2082 purge at +50\u2013100
    Pa, so any micro-leak pushes inert gas out instead of letting oxygen in."
--- !u!65 &8628683947925161648
